# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the template, it holds no real values
!.env.example

# PrabalOS firmware + device secrets.
# The sketch tree lives at ../PrabalOS, outside this repo, so it is already
# unreachable from here — this entry only matters if the repo root is ever
# moved up a level. The device HMAC key must never reach a public remote.
#
# The leading slash is load-bearing. Unanchored, `PrabalOS/` matches a
# directory of that name at ANY depth, and git is case-insensitive on Windows
# and macOS — which silently excluded src/lib/prabalos/ and
# src/app/api/prabalos/, i.e. the entire backend, from every commit.
/PrabalOS/
secrets.h
*.secrets.h
partitions.local.csv

# Stray vendor installers that land in public/ are served to the internet
# verbatim if committed. Nothing executable belongs in a static asset folder.
/public/**/*.exe
/public/**/*.msi
/public/**/*.dmg
