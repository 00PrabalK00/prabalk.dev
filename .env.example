# Optional. Without a token the site still works: repos, activity stream,
# language stats and star counts all come from the unauthenticated REST API.
#
# With a token you get:
#   - the contribution heatmap (GraphQL-only, auth required)
#   - 5000 req/hr instead of 60, so the panel never rate-limits under traffic
#
# Create at https://github.com/settings/tokens?type=beta
# Scopes needed: NONE for public data (a classic token with `read:user` is enough
# for the contribution calendar). Never commit the real value.
GITHUB_TOKEN=

# Defaults to 00PrabalK00 if unset.
NEXT_PUBLIC_GITHUB_USER=00PrabalK00

# Canonical origin used by metadata, OG tags, sitemap and robots.
# Defaults to https://www.prabalkhare.com, which is what Vercel currently
# serves — the bare apex 308-redirects to it. Set this if the project's
# primary domain is ever changed to the apex.
# NEXT_PUBLIC_SITE_URL=https://prabalkhare.com

# ---------------------------------------------------------------------------
# PrabalOS — the private family terminal. Everything below is server-only.
# Generate the secret values with:  node scripts/gen-credentials.mjs "<password>"
# Never add NEXT_PUBLIC_ to any of these; that would ship them to the browser.
# ---------------------------------------------------------------------------

# Upstash Redis — the only mutable store. From the Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# /login credentials. Password is scrypt(N=32768, r=8, p=1, 64 bytes), hex.
PRABALOS_PW_SALT=
PRABALOS_PW_HASH=

# TOTP second factor, RFC 6238, base32, 30 s period, 6 digits.
PRABALOS_TOTP_SECRET=

# HMAC key for the session cookie. Rotating it invalidates every session.
PRABALOS_SESSION_KEY=

# The physical device. The key signs every request the ESP32 makes; it also
# lives in the device's NVS and nowhere else.
PRABALOS_DEVICE_ID=PRABALOS_HOME_01
PRABALOS_DEVICE_KEY=

# Vercel Blob, for voice notes. Create a Blob store in the Vercel dashboard and
# it offers this token. Without it the recorder returns a clear 503 and the rest
# of PrabalOS carries on working.
BLOB_READ_WRITE_TOKEN=

# Emergency sign-in when the authenticator is unavailable. Generate with:
#   node scripts/gen-credentials.mjs '<password>' --recovery
# Replaces the TOTP factor only; the password is still required. Five uses.
PRABALOS_RECOVERY_SALT=
PRABALOS_RECOVERY_HASH=

# IANA zone names for the two clocks on the device's home screen. The server
# renders both times because the ESP32 has no timezone database.
PRABALOS_TZ_AWAY=America/New_York
PRABALOS_TZ_HOME=Asia/Bangkok

# Discord webhook for push notifications on button presses and drawings.
# Optional — leave blank and notifications are simply off.
#
# Server-side only, never NEXT_PUBLIC: the URL is a bearer credential. Anyone
# who has it can post to that channel, so treat it like a password and use a
# channel you would not mind resetting. Get it from Discord:
#   Channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
PRABALOS_DISCORD_WEBHOOK=

# Discord slash commands (/status, /say, /note, /love, /state).
#
# The webhook above is outbound only, so commands come in through a separate
# Interactions endpoint: Developer Portal -> your app -> General Information ->
# Interactions Endpoint URL = https://prabalkhare.com/api/prabalos/discord
#
# Public key: General Information. Not secret, but a wrong one means every
# command is rejected as an invalid signature.
PRABALOS_DISCORD_PUBLIC_KEY=
#
# Your own Discord user ID, with Developer Mode on: right-click your name ->
# Copy User ID. A valid signature only proves the request came from Discord,
# not who typed the command — this is what stops anyone else driving the
# device. Unset means nobody is allowed.
PRABALOS_DISCORD_USER_ID=
#
# Only needed locally, by scripts/register-discord-commands.mjs. The running
# site never reads these, so they do not belong in Vercel.
PRABALOS_DISCORD_APP_ID=
PRABALOS_DISCORD_BOT_TOKEN=
